# Copy to .env (git-ignored) and fill in the token.
#
# Generate one:
#   docker run --rm akitaonrails/ai-memory:3.4.4 generate-auth-token
#
# The server refuses non-loopback binds without a token; with the loopback bind above it is
# still worth setting, because every client (MCP, curl, the seed script) uses it.
AI_MEMORY_AUTH_TOKEN=
