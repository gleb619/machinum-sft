# Secrets and endpoints — copy to `.env` and fill in. `.env` is git-ignored.
#
# A value may be plain, or `enc:v1:<token>` as written by `msft secrets encrypt`. The
# encrypted `.env` is copied to the remote box as-is: names stay readable, values do not,
# and the default decryption key lives in `src/msft/secrets.py`. Set `MSFT_SECRET_KEY`
# to a private Fernet key if the checked-in obfuscation key is not enough.

# Hugging Face token (needed for gated models, e.g. Gemma)
HF_TOKEN=

# Where the training artifacts go
MSFT_HOME=./out
MSFT_CACHE=./out/cache

# Optional: remote GPU host. Do NOT commit a real address; keep it in .env.
# MSFT_REMOTE_HOST=user@example-host
# MSFT_REMOTE_DIR=~/machinum-sft

# Optional: W&B (leave empty to stay offline)
WANDB_API_KEY=
WANDB_MODE=offline
