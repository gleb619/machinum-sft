# Secrets and endpoints — copy to `.env` and fill in. `.env` is git-ignored.

# Hugging Face token (needed for gated models, e.g. Gemma)
HF_TOKEN=

# Where the training artifacts go
MSFT_HOME=./out
MSFT_CACHE=./out/cache

# Optional: remote GPU host. Do NOT commit a real address; keep it in .env.
# MSFT_REMOTE_HOST=user@example-host
# MSFT_REMOTE_DIR=~/machinum-sft

# Optional: W&B (leave empty to stay offline)
WANDB_API_KEY=
WANDB_MODE=offline
